# Copy to .env on the VPS. Never commit the real .env file.
# Keep the app bound to loopback when a host reverse proxy handles public HTTPS.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8088

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
SESSION_COOKIE_SECURE=true

# Public business details
BRAND_NAME=Swami Bags
WHATSAPP_NUMBER=919876543210
BUSINESS_PHONE=+91 98765 43210
BUSINESS_EMAIL=
BUSINESS_ADDRESS=
PUBLIC_BASE_URL=https://your-domain.example

# OpenAI image generation
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1536x1024
